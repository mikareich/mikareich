{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "nursery": {
        "noTailwindArbitraryValue": "off"
      },
      "style": {
        "useComponentExportOnlyModules": {
          "level": "on",
          "options": {
            "allowExportNames": [
              "generateMetadata",
              "generateStaticParams",
              "metadata"
            ]
          }
        }
      }
    },
    "domains": {
      "next": "all",
      "react": "all",
      "tailwind": "all"
    }
  },
  "overrides": [
    {
      "includes": ["public/**/*.svg"],
      "formatter": { "enabled": false }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
